# uploads/.htaccess
# Disable PHP Execution
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Remove PHP handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .pht .inc
RemoveType .php .phtml .php3 .php4 .php5 .pht .inc

# Block access to specific extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|pht|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
