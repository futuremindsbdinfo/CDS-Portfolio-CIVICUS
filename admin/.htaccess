# admin/.htaccess
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Handle extensionless URLs inside admin (/admin/login -> login.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

<IfModule mod_php.c>
    php_flag engine on
</IfModule>

