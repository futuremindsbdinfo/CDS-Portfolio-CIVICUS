<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (Skip localhost/127.0.0.1 for local dev)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle /admin or /admin/
    RewriteRule ^admin/?$ admin/login.php [L,QSA]

    # Handle extensionless URLs (/about -> about.php, /admin/login -> admin/login.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

<IfModule mod_php.c>
    # Production Error Settings
    php_flag display_errors Off
    php_flag log_errors On
    # Ensure errors are logged to the project's log directory
    php_value error_log "logs/error.log"
</IfModule>

# Prevent directory listing
Options -Indexes

# Custom Error Pages
ErrorDocument 404 /404.php

